# PostgreSQL Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sanchay_dev?schema=public"

# Application Port
PORT=3000

# JWT Secrets & Expiration
JWT_ACCESS_SECRET="your_jwt_access_secret_min_32_characters_long"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_min_32_characters_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS and Public URL
FRONTEND_URL="http://localhost:5173"
BACKEND_PUBLIC_URL="http://localhost:3000"

# Local file storage
UPLOAD_DIR="./uploads"

# Platform configuration
PLATFORM_FEE_PER_KG=2

